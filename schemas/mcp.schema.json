{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runkids/skillshare/main/schemas/mcp.schema.json",
  "title": "Skillshare MCP Source",
  "type": "object",
  "required": ["servers"],
  "additionalProperties": false,
  "properties": {"servers": {"$ref": "#/$defs/servers"}},
  "$defs": {
    "targets": {"type": "array", "uniqueItems": true, "items": {"anyOf": [{"enum": ["claude", "codex", "cursor", "vscode", "opencode", "kilocode", "grok", "antigravity", "amp", "claude-desktop", "cline", "copilot", "factory", "gemini", "goose", "junie", "kiro", "lmstudio", "warp", "windsurf", "pi"]}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "A target that is another account of an Agent, declared under targets with agent and config_dir. Global config only."}]}},
    "directTools": {
      "description": "pi-mcp-adapter only: register a server's tools as individual Pi tools. true for all, a list of tool names, or \"search\" to register them inactive until a search activates them. Other Agents ignore it. Under mcp or a project it is the default for servers that do not set their own.",
      "oneOf": [{"type": "boolean"}, {"const": "search"}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]
    },
    "reference": {
      "type": "object", "required": ["fromEnv"], "additionalProperties": false,
      "properties": {"fromEnv": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
    },
    "value": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/reference"}]},
    "servers": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/server"}
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "targets": {"$ref": "#/$defs/targets"},
        "directTools": {"$ref": "#/$defs/directTools"},
        "servers": {"$ref": "#/$defs/servers"}
      }
    },
    "globalConfiguration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "targets": {"$ref": "#/$defs/targets"},
        "directTools": {"$ref": "#/$defs/directTools"},
        "servers": {"$ref": "#/$defs/servers"},
        "projects": {
          "type": "object",
          "description": "Project folders this global config syncs into, keyed by absolute path (or ~/...). Each takes what that project's own config.yaml would hold under mcp.",
          "additionalProperties": {"$ref": "#/$defs/configuration"}
        }
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "piExtension": {"enum": ["builtin", "pi-mcp-adapter", "pi-mcp-extension"]},
        "transport": {"enum": ["stdio", "streamable-http"]},
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "url": {"type": "string", "pattern": "^https?://"},
        "env": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "headers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "bearerToken": {"$ref": "#/$defs/reference"},
        "targets": {"$ref": "#/$defs/targets"},
        "directTools": {"$ref": "#/$defs/directTools"},
        "piOptions": {"type": "object", "description": "Pi built-in or pi-mcp-adapter per-server options. Known built-in fields are validated; unknown fields are preserved."},
        "piOptionsPrune": {"type": "boolean", "description": "Remove cleared Pi options only if Skillshare owns their unchanged values."},
        "disabled": {"const": true, "description": "Project mode only: turn off a server that the Agent's global config defines. Supported by opencode, kilocode and pi with pi-mcp-adapter."}
      },
      "oneOf": [
        {"required": ["disabled"], "not": {"anyOf": [{"required": ["directTools"]}, {"required": ["command"]}, {"required": ["url"]}, {"required": ["args"]}, {"required": ["env"]}, {"required": ["headers"]}, {"required": ["bearerToken"]}, {"required": ["transport"]}]}},
        {"required": ["command"], "not": {"anyOf": [{"required": ["disabled"]}, {"required": ["url"]}, {"required": ["headers"]}, {"required": ["bearerToken"]}]}, "properties": {"transport": {"const": "stdio"}}},
        {"required": ["url"], "not": {"anyOf": [{"required": ["disabled"]}, {"required": ["command"]}, {"required": ["args"]}, {"required": ["env"]}]}, "properties": {"transport": {"const": "streamable-http"}}}
      ]
    }
  }
}
